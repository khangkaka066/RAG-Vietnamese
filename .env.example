# OpenRouter API key. Required to enable LLM-based generation.
# Without it, the service automatically falls back to the offline, rule-based
# extractive generator (no network calls, no API key needed).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter model id. Optional -- defaults to "openrouter/free", OpenRouter's
# official free auto-router (picks a suitable free-tier model, supports
# structured JSON output). Override with a specific free model if you want a
# more predictable choice, e.g. "deepseek/deepseek-chat-v3.1:free" or
# "meta-llama/llama-3.3-70b-instruct:free".
OPENROUTER_MODEL=openrouter/free

# Retriever mode: lexical (default, fully offline) | embedding | hybrid
VSF_RETRIEVER=lexical
